.echo === Combined HD layout synthetic geometry diagnostic ===
.echo HDLAYOUT_SYNTHETIC_GEOMETRY proof_class=forced_geometry_only input_proof=false visible_proof=false promotion_ready=false
.echo Hooks native setup MOV EAX ECX at 0040A431 after resource load and all six initial draws
.echo Injects last-descriptor redraw then native list scan and returns at original RET 0040A433
.echo Saves menu-only t1 t2 t3 t4 t5 t8 t9 and uses t0 phase marker after t14 gameplay entry
.echo Requires neutral cursor left of every panel and zero click state and disabled visibility-edge instrumentation
.echo No persistent executable bytes or input globals are written

bp 0040B7AE ".if (@$t14 != 0) { .printf \"HDLAYOUT_TOOLTIP_INIT ret=%p left=%d top=%d right=%d bottom=%d surface=%p map_surface=%p size=(%d,%d)\\n\", poi(@esp), poi(00526ef8), poi(00526efc), poi(00526f00), poi(00526f04), poi(00526ef4), poi(005202e0), wo(poi(005202e0)), wo(poi(005202e0)+2); }; gc"
bp 0040892B ".if (@$t14 != 0) { .printf \"HDLAYOUT_TOOLTIP_DRAW ret=%p left=%d top=%d right=%d bottom=%d surface=%p map_surface=%p mouse=(%d,%d)\\n\", poi(@esp), poi(00526ef8), poi(00526efc), poi(00526f00), poi(00526f04), poi(00526ef4), poi(005202e0), poi(00544cfc)>>by(0054512c), poi(00544d00)>>by(0054512c); }; gc"

bp /1 0040A431 ".if ((@$t14 != 0) & (poi(005202e0) != 0) & (poi(0052030c) != 0)) { .if ((wo(poi(005202e0)) == 0n800) & (wo(poi(005202e0)+2) == 0n600) & (poi(00511230) == poi(005202e0)) & (poi(00419d65) == 0n800) & (poi(00419d8e) == 0n800) & (poi(00511d40) == 0n608) & (poi(00511d44) == 0n528) & (poi(00511e49) == 0n736) & (poi(00511e4d) == 0n560) & (poi(00511e65) == 004191f0) & ((poi(00544cfc)>>by(0054512c)) >= 0) & ((poi(00544cfc)>>by(0054512c)) < 0n608) & (poi(00544d04) == 0) & (by(005451c0) == 0) & (@$t6 == 0) & (@$t18 == 0)) { r @$t0 = 0x48444745; r @$t1 = @ebx; r @$t2 = @ecx; r @$t3 = @edx; r @$t4 = @esi; r @$t5 = @edi; r @$t8 = @ebp; r @$t9 = @efl; .printf \"HDLAYOUT_SYNTHETIC_GEOMETRY_BEGIN trigger=0040a431 resume=0040a433 saved_esp=%p mouse=(%d,%d) proof_class=forced_geometry_only\\n\", @esp, poi(00544cfc)>>by(0054512c), poi(00544d00)>>by(0054512c); .printf \"HDLAYOUT_PANEL_REDRAW_INVOKE desc=00511e49 x=%d y=%d helper=00419d60 return=0040a460\\n\", poi(00511e49), poi(00511e4d); r esp=@esp-8; ed @esp 0040a460; ed @esp+4 0040a433; r eax=00511e49; r ecx=00511e49; r eip=00419d60; } .else { .echo HDLAYOUT_SYNTHETIC_GEOMETRY_SKIPPED incompatible_or_non_neutral_state; }; } .else { .echo HDLAYOUT_SYNTHETIC_GEOMETRY_SKIPPED resources_not_ready; }; gc"
bp /1 0040A433 ".if (@$t0 == 0x48444745) { .printf \"HDLAYOUT_SYNTHETIC_GEOMETRY_RETURN resume=0040a433 esp=%p proof_class=forced_geometry_only\\n\", @esp; r eax=@$t2; r ebx=@$t1; r ecx=@$t2; r edx=@$t3; r esi=@$t4; r edi=@$t5; r ebp=@$t8; r efl=@$t9; r @$t0 = 0; }; gc"
bp 0040A400 ".if (@$t14 != 0) { .printf \"HDLAYOUT_PANEL_SETUP ret=%p clip_single=%d clip_list=%d e0=(%d,%d) e1=(%d,%d) e2=(%d,%d) e3=(%d,%d) e4=(%d,%d) e5=(%d,%d) render=%p map_surface=%p size=(%d,%d)\\n\", poi(@esp), poi(00419d65), poi(00419d8e), poi(00511d40), poi(00511d44), poi(00511d75), poi(00511d79), poi(00511daa), poi(00511dae), poi(00511ddf), poi(00511de3), poi(00511e14), poi(00511e18), poi(00511e49), poi(00511e4d), poi(00511230), poi(005202e0), wo(poi(005202e0)), wo(poi(005202e0)+2); }; gc"
bp 00419DA7 ".if ((@$t14 != 0) & (@ecx >= 00511d40) & (@ecx < 00511e80)) { .printf \"HDLAYOUT_PANEL_DRAW desc=%p x=%d y=%d flags=0x%02x draw=%p hit=%p render=%p map_surface=%p\\n\", @ecx, poi(@ecx), poi(@ecx+4), by(@ecx+8), poi(@ecx+0n28), poi(@ecx+0n32), poi(00511230), poi(005202e0); }; gc"
bp 00419D60 ".if ((@$t14 != 0) & (@eax >= 00511d40) & (@eax < 00511e80)) { .printf \"HDLAYOUT_PANEL_REDRAW desc=%p x=%d y=%d flags=0x%02x draw=%p hit=%p render=%p map_surface=%p\\n\", @eax, poi(@eax), poi(@eax+4), by(@eax+8), poi(@eax+0n28), poi(@eax+0n32), poi(00511230), poi(005202e0); }; gc"
bp 00419D6D ".if ((@$t14 != 0) & (@ecx >= 00511d40) & (@ecx < 00511e80)) { .printf \"HDLAYOUT_PANEL_REDRAW_ALLOWED desc=%p x=%d y=%d clip=%d draw=%p render=%p map_surface=%p\\n\", @ecx, poi(@ecx), poi(@ecx+4), poi(00419d65), poi(@ecx+0n28), poi(00511230), poi(005202e0); }; gc"
bp 00419DC0 ".if ((@$t14 != 0) & (@eax == 00511d40)) { .printf \"HDLAYOUT_PANEL_HITSCAN list=%p mouse=(%d,%d) e0=(%d,%d) e5=(%d,%d)\\n\", @eax, poi(00544cfc)>>by(0054512c), poi(00544d00)>>by(0054512c), poi(00511d40), poi(00511d44), poi(00511e49), poi(00511e4d); }; gc"
